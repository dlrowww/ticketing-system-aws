# Docker Hub Configuration
DOCKER_USERNAME=your-docker-username

# Server Configuration
API_BASE_URL=http://your-server-domain:your-api-port
API_PORT=your-api-port
FRONTEND_PORT=your-frontend-port
STORAGE_PATH=/opt/storage/path/to/your/project

# PostgreSQL (External University Database)
POSTGRES_HOST=TBD_POSTGRES_HOST
POSTGRES_USER=TBD
POSTGRES_PASSWORD=TBD
POSTGRES_DATABASE=ticketing_system_XXX

# JWT Configuration (Generate strong secret: openssl rand -base64 32)
JWT_KEY=YOUR_64_CHARACTER_SECRET_KEY_HERE_MINIMUM_32_CHARS_VERY_IMPORTANT
JWT_ISSUER=IronPackTicketingSystem
JWT_AUDIENCE=IronPackUsers

# Email Configuration
# Option A: Use real SMTP (recommended for university demo - no disk usage)
#   Requires Gmail App Password: https://myaccount.google.com/apppasswords
#   Or use student Outlook: smtp.office365.com, port 587
Email__UsePickupDirectory=false
Email__Host=smtp.gmail.com
Email__Port=587
Email__Username=your-email@gmail.com
Email__Password=your-gmail-app-password
Email__From=ticketing@ironpack.pl

# Option B: Use pickup directory (for local testing only - creates .eml files)
#   Uncomment below and comment out Option A
# Email__UsePickupDirectory=true
# Email__PickupDirectory=.maildrop

# Admin Bootstrap
ADMIN_EMAIL=TBD
ADMIN_PASSWORD=STRONG_PASSWORD_HERE

# Seeding Configuration
# Set to 'true' to seed 49 demo tickets on first startup
# This is recommended for demo/testing. Set to 'false' for real production.
SEED_DEMO_DATA=false
