@import 'bootstrap/dist/css/bootstrap.min.css';
body {
    background: linear-gradient(120deg, #b2cdf0 0%, #67b0ff 100%);
    min-height: 100vh;
    font-family: 'Segoe UI', Arial, sans-serif;
}
.login-card {
    max-width: 380px;
    margin: 60px auto;
    background: #fff;
    padding: 2.5rem 2rem 2rem 2rem;
    border-radius: 1.5rem;
    box-shadow: 0 6px 32px 0 rgba(13,110,253,0.10);
    border-top: 6px solid #0d6efd;
}
.form-label {
    color: #0d6efd;
    font-weight: 500;
}
.btn-primary {
    background: linear-gradient(90deg, #0d6efd 60%, #67b0ff 100%);
    border: none;
    font-weight: 600;
}
.btn-primary:hover, .btn-primary:focus {
    background: linear-gradient(90deg, #0857b7 60%, #2899ff 100%);
}
.form-control:focus {
    border-color: #0d6efd;
    box-shadow: 0 0 0 0.15rem rgba(13,110,253,.15);
}
.lang-select-inside {
    width: 90px;
    margin-left: auto;
    margin-bottom: 10px;
}
h2 {
    color: #0d6efd;
    font-weight: bold;
    letter-spacing: 1px;
}
@media (max-width: 450px) {
    .login-card { margin: 30px 8px; }
}