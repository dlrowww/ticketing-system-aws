<script lang="ts">
    import type { TicketListItem, TicketQuery, TicketsTableConfig, TicketSortableField } from '$lib/types/tickets';
    import type { PagedResult } from '$lib/types/tickets';

    import { fetchTickets } from '$lib/services/Tickets';
    import { lookups, toOptions } from '$lib/lookups/Lookups';
    import TicketStatusBadge from '$lib/components/TicketStatusBadge.svelte';
    import { Category as CAT, Priority as PRI, CategoryKey, PriorityKey } from '$lib/types/generated/enums';
    import { getMessage } from '$lib/i18n';

    let {
        config,
        initial,
        initialQuery,
        onRow,
        onBulk,
        onExport
    }: {
        config: TicketsTableConfig;
        initial?: PagedResult<TicketListItem>;
        initialQuery?: TicketQuery;
        onRow?: (payload: { action: string; id: number }) => void;
        onBulk?: (payload: { action: string; ids: number[] }) => void;
        onExport?: () => void;
    } = $props();

    // --- state ---
    type PageData = PagedResult<TicketListItem>;

    let loading = $state(false);
    let errorMsg = $state<string | null>(null);

    const query = $state<TicketQuery>({
        page: initialQuery?.page ?? 1,
        pageSize: initialQuery?.pageSize ?? 10,
        sortBy: initialQuery?.sortBy ?? 'createdAt',
        sortDir: initialQuery?.sortDir ?? 'desc',
        search: initialQuery?.search ?? '',
        status: initialQuery?.status ?? 'All',
        category: initialQuery?.category ?? 'All',
        priority: initialQuery?.priority ?? 'All',
        dateFrom: initialQuery?.dateFrom,
        dateTo: initialQuery?.dateTo
    });

    const qSort = `${(query.sortBy ?? 'createdAt')}:${(query.sortDir ?? 'desc')}` as string;
    let page = $state<PageData>(
        initial ?? { items: [], total: 0, page: query.page ?? 1, size: query.pageSize ?? 10, totalPages: 1, hasNext: false, hasPrevious: false, sort: qSort }
    );
    let selected = $state<Set<number>>(new Set());

    // --- lookups/options ---
    const statusOptions = $derived(toOptions(lookups.ticketStatus()));
    const categoryOptions = $derived(toOptions(lookups.category()));
    const priorityOptions = $derived(toOptions(lookups.priority()));

    // --- fetch ---
    async function load() {
        loading = true;
        errorMsg = null;
        try {
            const res = await fetchTickets(query, fetch);
            console.log('tickets:', res.items.length, res.total);
            page = res;
            selected = new Set();
        } catch (e: any) {
            errorMsg = e?.message ?? 'Failed to load tickets';
        } finally {
            loading = false;
        }
    }

    let skipFirst = $state(!!initial);

    // auto-load on query changes
    $effect(() => {
        void query.page; void query.pageSize; void query.sortBy; void query.sortDir;
        void query.search; void query.status; void query.category; void query.priority;
        void query.dateFrom; void query.dateTo;
        if (skipFirst) { skipFirst = false; return; }
        load();
    });

    // --- handlers ---
    function toggleSort(col: TicketSortableField) {
        if (query.sortBy === col) {
            query.sortDir = query.sortDir === 'asc' ? 'desc' : 'asc';
        } else {
            query.sortBy = col;
            query.sortDir = 'asc';
        }
        query.page = 1;
    }

    function ariaSort(col: TicketSortableField) {
        if (query.sortBy !== col) return 'none';
        return query.sortDir === 'asc' ? 'ascending' : 'descending';
    }

    function setPage(p: number) {
        if (p < 1) return;
        const max = Math.max(1, Math.ceil(page.total / (query.pageSize ?? 10)));
        query.page = Math.min(p, max);
    }

    function setPageSize(size: number) {
        query.pageSize = size;
        query.page = 1;
    }
  
    function toggleRow(id: number, on: boolean) {
        const next = new Set(selected);
        if (on) {
            next.add(id);
        } else {
            next.delete(id);
        }
        selected = next;
    }

    function toggleAll(on: boolean) {
        const next = new Set<number>();
        if (on) {
            page.items.forEach(i => next.add(i.ticketId));
        }
        selected = next;
    }

    const defaultColumns: Array<keyof TicketListItem | 'actions'> = [
        'ticketId', 'title', 'category', 'priority', 'status', 'createdAt', 'assignedToName', 'actions'
    ];
    const columns = $derived(config.columns ?? defaultColumns);

    function catLabel(id: typeof CAT[keyof typeof CAT]) {
        return getMessage(CategoryKey[id] ?? 'category_unknown');
    }
    
    function priLabel(id: typeof PRI[keyof typeof PRI]) {
        return getMessage(PriorityKey[id] ?? 'priority_unknown');
    }

    // select-all checkbox indeterminate
    let selectAllEl = $state<HTMLInputElement | null>(null);

    $effect(() => {
        if (!selectAllEl) return;
        selectAllEl.indeterminate = selected.size > 0 && selected.size < page.items.length;
    });

</script>

<!-- Toolbar -->
<div class="d-flex flex-wrap gap-2 align-items-end mb-3">
    {#if config.enableSearch ?? true}
        <div class="me-2">
        <label for="search" class="form-label mb-1">{getMessage('search')}</label>
        <input
            class="form-control"
            placeholder={getMessage('search_placeholder')}
            value={query.search ?? ''}
            id="search"
            oninput={(e) => { query.search = (e.target as HTMLInputElement).value; query.page = 1; }}
        />
        </div>
        {/if}

    {#if config.enableFilters ?? true}
        <div class="me-2">
        <label for="search-status" class="form-label mb-1">{getMessage('status')}</label>
        <select class="form-select" id="search-status" bind:value={query.status as any} onchange={() => { query.page = 1; }}>
            <option value={'All'}>{getMessage('all')}</option>
            {#each statusOptions as opt}
            <option value={opt.value}>{getMessage(opt.labelKey)}</option>
            {/each}
        </select>
        </div>

        <div class="me-2">
        <label for="search-category" class="form-label mb-1">{getMessage('category')}</label>
        <select class="form-select" id="search-category" bind:value={query.category as any} onchange={() => { query.page = 1; }}>
            <option value={'All'}>{getMessage('all')}</option>
            {#each categoryOptions as opt}
            <option value={opt.value}>{getMessage(opt.labelKey)}</option>
            {/each}
        </select>
        </div>

        <div class="me-2">
        <label for="search-priority" class="form-label mb-1">{getMessage('priority')}</label>
        <select class="form-select" id="search-priority" bind:value={query.priority as any} onchange={() => { query.page = 1; }}>
            <option value={'All'}>{getMessage('all')}</option>
            {#each priorityOptions as opt}
            <option value={opt.value}>{getMessage(opt.labelKey)}</option>
            {/each}
        </select>
        </div>

        <div class="me-2">
        <label for="search-date-from" class="form-label mb-1">{getMessage('date_from')}</label>
        <input type="date" class="form-control" id="search-date-from" bind:value={query.dateFrom} onchange={() => { query.page = 1; }} />
        </div>
        <div class="me-2">
        <label for="search-date-to" class="form-label mb-1">{getMessage('date_to')}</label>
        <input type="date" class="form-control" id="search-date-to" bind:value={query.dateTo} onchange={() => { query.page = 1; }} />
        </div>
    {/if}

    <div class="ms-auto d-flex gap-2">
        {#if (config.enableExportCsv ?? true)}
        <button class="btn btn-outline-secondary btn-sm" onclick={() => onExport?.()}>
            {getMessage('export_csv')}
        </button>
        {/if}
    </div>
</div>

<!-- Bulk actions -->
{#if selected.size > 0 && (config.bulkActions?.length ?? 0) > 0}
    <div class="alert alert-light d-flex align-items-center justify-content-between py-2">
        <div><strong>{selected.size}</strong> {getMessage('selected')}</div>
        <div class="d-flex gap-2">
        {#each config.bulkActions ?? [] as act}
            <button class="btn btn-sm btn-outline-primary"
                    onclick={() => onBulk?.({ action: act.id, ids: Array.from(selected) })}>
            {getMessage(act.label)}
            </button>
        {/each}
        </div>
    </div>
{/if}

<!-- Table -->
<div class="table-responsive border rounded">
  <table class="table table-sm align-middle mb-0">
    <thead class="table-light">
      <tr>
        <th style="width:32px;">
          <input
            bind:this={selectAllEl}
            type="checkbox"
            checked={selected.size === page.items.length && page.items.length > 0}
            onchange={(e) => toggleAll((e.target as HTMLInputElement).checked)}
          />
        </th>

        {#if columns.includes('ticketId')}
          <th role="columnheader" aria-sort={ariaSort('ticketId')} class="sortable" onclick={() => toggleSort('ticketId')}>
            {getMessage('ticketId')}
          </th>
        {/if}
        {#if columns.includes('title')}
          <th role="columnheader" aria-sort={ariaSort('title')} class="sortable" onclick={() => toggleSort('title')}>
            {getMessage('title')}
          </th>
        {/if}
        {#if columns.includes('category')}
          <th role="columnheader" aria-sort={ariaSort('category')} class="sortable" onclick={() => toggleSort('category')}>
            {getMessage('category')}
          </th>
        {/if}
        {#if columns.includes('priority')}
          <th role="columnheader" aria-sort={ariaSort('priority')} class="sortable" onclick={() => toggleSort('priority')}>
            {getMessage('priority')}
          </th>
        {/if}
        {#if columns.includes('status')}
          <th role="columnheader" aria-sort={ariaSort('status')} class="sortable" onclick={() => toggleSort('status')}>
            {getMessage('status')}
          </th>
        {/if}
        {#if columns.includes('createdAt')}
          <th role="columnheader" aria-sort={ariaSort('createdAt')} class="sortable" onclick={() => toggleSort('createdAt')}>
            {getMessage('createdAt')}
          </th>
        {/if}
        {#if columns.includes('updatedAt')}
          <th role="columnheader" aria-sort={ariaSort('updatedAt')} class="sortable" onclick={() => toggleSort('updatedAt')}>
            {getMessage('updatedAt')}
          </th>
        {/if}
        {#if columns.includes('createdByName')}
          <th role="columnheader" aria-sort={ariaSort('createdByName')} class="sortable" onclick={() => toggleSort('createdByName')}>
            {getMessage('created_by')}
          </th>
        {/if}
        {#if columns.includes('assignedToName')}
          <th role="columnheader" aria-sort={ariaSort('assignedToName')} class="sortable" onclick={() => toggleSort('assignedToName')}>
            {getMessage('assigned_to')}
          </th>
        {/if}

        {#if columns.includes('actions')}
          <th class="text-end">{getMessage('actions')}</th>
        {/if}
      </tr>
    </thead>

    <tbody>
      {#if loading}
        <tr><td colspan="99" class="text-center py-4">{getMessage('loading')}</td></tr>
      {:else if errorMsg}
        <tr><td colspan="99" class="text-danger py-3">{errorMsg}</td></tr>
      {:else if page.items.length === 0}
        <tr><td colspan="99" class="text-center py-4">{getMessage('no_results')}</td></tr>
      {:else}
        {#each page.items as row (row.ticketId)}
          <tr>
            <td>
              <input
                type="checkbox"
                checked={selected.has(row.ticketId)}
                onchange={(e) => toggleRow(row.ticketId, (e.target as HTMLInputElement).checked)}
              />
            </td>

            {#if columns.includes('ticketId')}
              <td>{row.ticketId}</td>
            {/if}
            {#if columns.includes('title')}
              <td class="text-truncate" style="max-width: 420px;">{row.title}</td>
            {/if}
            {#if columns.includes('category')}
              <td>{catLabel(row.category)}</td>
            {/if}
            {#if columns.includes('priority')}
              <td>{priLabel(row.priority)}</td>
            {/if}
            {#if columns.includes('status')}
              <td><TicketStatusBadge status={row.status} /></td>
            {/if}
            {#if columns.includes('createdAt')}
              <!-- <td>{new Date(row.createdAt).toLocaleString()}</td> -->
              <td>{new Intl.DateTimeFormat('pl-PL', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(row.createdAt))}</td>
            {/if}
            {#if columns.includes('updatedAt')}
              <!-- <td>{row.updatedAt ? new Date(row.updatedAt).toLocaleString() : '-'}</td> -->
              <td>{row.updatedAt ? new Intl.DateTimeFormat('pl-PL', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(row.updatedAt)) : '-'}</td>
            {/if}
            {#if columns.includes('createdByName')}
              <td>{row.createdByName ?? '-'}</td>
            {/if}
            {#if columns.includes('assignedToName')}
              <td>{row.assignedToName ?? '-'}</td>
            {/if}

            {#if columns.includes('actions')}
              <td class="text-end">
                {#each (config.actions ?? []) as act}
                  <button
                    class="btn btn-link btn-sm text-decoration-none"
                    onclick={() => onRow?.({ action: act.id, id: row.ticketId })}
                    aria-label={getMessage(act.label)}
                  >
                    {getMessage(act.label)}
                  </button>
                {/each}
              </td>
            {/if}
          </tr>
        {/each}
      {/if}
    </tbody>
  </table>
</div>

<!-- Pagination -->
<div class="d-flex align-items-center justify-content-between mt-3">
  <div class="d-flex align-items-center gap-2">
    <span>{getMessage('rows_per_page')}:</span>
    <select class="form-select form-select-sm w-auto" bind:value={query.pageSize as any} onchange={() => setPageSize(Number(query.pageSize ?? 10))}>
      <option value="10">10</option>
      <option value="25">25</option>
      <option value="50">50</option>
    </select>
    <span class="text-muted ms-2">
      {page.total} {getMessage('total')}
    </span>
  </div>

  <div class="btn-group">
    <button class="btn btn-outline-secondary btn-sm" onclick={() => setPage(1)} disabled={(query.page ?? 1) <= 1}>&laquo;</button>
    <button class="btn btn-outline-secondary btn-sm" onclick={() => setPage((query.page ?? 1) - 1)} disabled={(query.page ?? 1) <= 1}>&lsaquo;</button>
    <span class="btn btn-light btn-sm disabled">
      {(query.page ?? 1)} / {Math.max(1, Math.ceil(page.total / (query.pageSize ?? 10)))}
    </span>
    <button class="btn btn-outline-secondary btn-sm" onclick={() => setPage((query.page ?? 1) + 1)} disabled={(query.page ?? 1) >= Math.ceil(page.total / (query.pageSize ?? 10))}>&rsaquo;</button>
    <button class="btn btn-outline-secondary btn-sm" onclick={() => setPage(Math.max(1, Math.ceil(page.total / (query.pageSize ?? 10))))} disabled={(query.page ?? 1) >= Math.ceil(page.total / (query.pageSize ?? 10))}>&raquo;</button>
  </div>
</div>

<style>
  .sortable { cursor: pointer; user-select: none; }
  .table td, .table th { vertical-align: middle; }
</style>