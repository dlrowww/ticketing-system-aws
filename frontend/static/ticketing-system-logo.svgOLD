<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="220" height="32" viewBox="0 0 220 32" role="img" aria-label="Ticketing System">
  <title>Ticketing System</title>

  <!-- Icon: ticket on IronPack red -->
  <g transform="translate(0,0)">
    <rect x="0" y="4" width="32" height="24" rx="6" fill="#d92129"/>
    <!-- ticket cutouts -->
    <circle cx="8" cy="16" r="2" fill="#ffffff"/>
    <circle cx="24" cy="16" r="2" fill="#ffffff"/>
    <!-- ticket line -->
    <rect x="12" y="15" width="8" height="2" fill="#ffffff"/>
  </g>

  <!-- Wordmark: black + red accent -->
  <text x="42" y="21" font-size="16" font-weight="700" fill="#110e0b">Ticketing</text>
  <text x="116" y="21" font-size="16" font-weight="700" fill="#d92129">System</text>
</svg>
