{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
    // Production: Set CORS__ALLOWEDORIGINS__0=https://your-frontend.com
    // Multiple origins: CORS__ALLOWEDORIGINS__0=https://app.com, CORS__ALLOWEDORIGINS__1=https://admin.app.com
  },
  "ConnectionStrings": {
    // use this when run BE locally
    "DefaultConnection": "Host=localhost;Port=5432;Database=ticketing_system;Username=admin;Password=admin"
    // use this when run BE in docker
    //"DefaultConnection": "Host=db;Port=5432;Database=ticketing_system;Username=admin;Password=admin"
  },
  "Jwt": {
    "Key": "DevelopmentSecretKeyForJWTTokenGeneration_MinimumLengthIs64Characters_DoNotUseInProduction_ChangeInProductionViaEnvironmentVariable",
    "Issuer": "TicketingSystem",
    "Audience": "TicketingSystemFrontend",
    "ExpirationMinutes": 480
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "noreply@ironpack.pl",
    "FromName": "IronPack - System Zgłoszeń / Ticketing System",
    "BaseUrl": "https://tickets.ironpack.pl",
    "TemplatesPath": "EmailTemplates",
    "UsePickupDirectory": false,
    "PickupDirectoryPath": null
  },
  "Backup": {
    "Enabled": false,
    "ScriptPath": "../../../scripts/backup-database.ps1",
    "Directory": "../../../backups",
    "RetentionDays": 30,
    "CronSchedule": "0 0 2 * * ?",
    "UseDocker": true,
    "DockerContainer": "ticketing-pg"
  }
}