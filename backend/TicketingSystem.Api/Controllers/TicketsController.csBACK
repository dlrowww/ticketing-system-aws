using Microsoft.AspNetCore.Mvc;
using TicketingSystem.Api.DTOs.Common;
using TicketingSystem.Api.DTOs.Tickets;
using TicketingSystem.Api.Enums.Tickets; // TicketStatus/TicketPriority/TicketCategory
using System.Text;

namespace TicketingSystem.Api.Controllers;

[ApiController]
[Route("api/[controller]")]
public class TicketsController : ControllerBase
{
    // In-memory seed so FE works today. Replace with EF query later.
    private static readonly List<TicketListItemDto> Seed = CreateSeed(120);

    [HttpGet]
    public ActionResult<PagedResult<TicketListItemDto>> Get(
        // paging
        [FromQuery] int page = 1,
        [FromQuery] int pageSize = 10,
        // search & filters
        [FromQuery] string? search = null,
        [FromQuery] byte? status = null,
        [FromQuery] byte? category = null,
        [FromQuery] byte? priority = null,
        [FromQuery] DateOnly? dateFrom = null,
        [FromQuery] DateOnly? dateTo = null,
        // sorting
        [FromQuery] string? sortBy = "createdAt",
        [FromQuery] string? sortDir = "desc"
    )
    {
        IEnumerable<TicketListItemDto> q = Seed;

        // search: id or title keywords
        if (!string.IsNullOrWhiteSpace(search))
        {
            var term = search.Trim().ToLowerInvariant();
            q = q.Where(t =>
                t.TicketId.ToString().Contains(term) ||
                (t.Title ?? "").ToLowerInvariant().Contains(term));
        }

        // numeric filters: FE sends numbers or omits for "All"
        if (status is > 0)   q = q.Where(t => t.Status == status);
        if (category is > 0) q = q.Where(t => t.Category == category);
        if (priority is > 0) q = q.Where(t => t.Priority == priority);

        if (dateFrom.HasValue) q = q.Where(t => DateOnly.FromDateTime(t.CreatedAt) >= dateFrom.Value);
        if (dateTo.HasValue)   q = q.Where(t => DateOnly.FromDateTime(t.CreatedAt) <= dateTo.Value);

        // sorting
        q = (sortBy?.ToLowerInvariant(), sortDir?.ToLowerInvariant()) switch
        {
            ("ticketId", "asc")          => q.OrderBy(t => t.TicketId),
            ("ticketId", _)              => q.OrderByDescending(t => t.TicketId),

            ("title", "asc")              => q.OrderBy(t => t.Title),
            ("title", _)                  => q.OrderByDescending(t => t.Title),

            ("category", "asc")           => q.OrderBy(t => t.Category),
            ("category", _)               => q.OrderByDescending(t => t.Category),

            ("priority", "asc")           => q.OrderBy(t => t.Priority),
            ("priority", _)               => q.OrderByDescending(t => t.Priority),

            ("status", "asc")             => q.OrderBy(t => t.Status),
            ("status", _)                 => q.OrderByDescending(t => t.Status),

            ("updatedAt", "asc")         => q.OrderBy(t => t.UpdatedAt),
            ("updatedAt", _)             => q.OrderByDescending(t => t.UpdatedAt),

            ("createdByName", "asc")    => q.OrderBy(t => t.CreatedByName),
            ("createdByName", _)        => q.OrderByDescending(t => t.CreatedByName),

            ("assignedToName", "asc")   => q.OrderBy(t => t.AssignedToName),
            ("assignedToName", _)       => q.OrderByDescending(t => t.AssignedToName),

            // default: createdAt
            (_, "asc")                    => q.OrderBy(t => t.CreatedAt),
            _                             => q.OrderByDescending(t => t.CreatedAt)
        };

        var total = q.Count();
        var items = q.Skip((page - 1) * pageSize).Take(pageSize).ToList();

        var result = new PagedResult<TicketListItemDto>(items, total, page, pageSize);
        return Ok(result);
    }

    [HttpGet("export")]
    public IActionResult Export(
        [FromQuery] string? search = null,
        [FromQuery] byte? status = null,
        [FromQuery] byte? category = null,
        [FromQuery] byte? priority = null,
        [FromQuery] DateOnly? dateFrom = null,
        [FromQuery] DateOnly? dateTo = null,
        [FromQuery] string? sortBy = "createdAt",
        [FromQuery] string? sortDir = "desc"
    )
    {
        // Reuse the same filtering/sorting but export all rows (no paging)
        var http = HttpContext.RequestServices.GetRequiredService<TicketsController>();
        // (or duplicate the filter code here; shown inline below for clarity)
        IEnumerable<TicketListItemDto> q = Seed;

        if (!string.IsNullOrWhiteSpace(search))
        {
            var term = search.Trim().ToLowerInvariant();
            q = q.Where(t =>
                t.TicketId.ToString().Contains(term) ||
                (t.Title ?? "").ToLowerInvariant().Contains(term));
        }
        if (status is > 0)   q = q.Where(t => t.Status == status);
        if (category is > 0) q = q.Where(t => t.Category == category);
        if (priority is > 0) q = q.Where(t => t.Priority == priority);
        if (dateFrom.HasValue) q = q.Where(t => DateOnly.FromDateTime(t.CreatedAt) >= dateFrom.Value);
        if (dateTo.HasValue)   q = q.Where(t => DateOnly.FromDateTime(t.CreatedAt) <= dateTo.Value);

        q = (sortBy?.ToLowerInvariant(), sortDir?.ToLowerInvariant()) switch
        {
            ("ticketId", "asc")          => q.OrderBy(t => t.TicketId),
            ("ticketId", _)              => q.OrderByDescending(t => t.TicketId),
            ("title", "asc")              => q.OrderBy(t => t.Title),
            ("title", _)                  => q.OrderByDescending(t => t.Title),
            ("category", "asc")           => q.OrderBy(t => t.Category),
            ("category", _)               => q.OrderByDescending(t => t.Category),
            ("priority", "asc")           => q.OrderBy(t => t.Priority),
            ("priority", _)               => q.OrderByDescending(t => t.Priority),
            ("status", "asc")             => q.OrderBy(t => t.Status),
            ("status", _)                 => q.OrderByDescending(t => t.Status),
            ("updatedAt", "asc")         => q.OrderBy(t => t.UpdatedAt),
            ("updatedAt", _)             => q.OrderByDescending(t => t.UpdatedAt),
            ("createdByName", "asc")    => q.OrderBy(t => t.CreatedByName),
            ("createdByName", _)        => q.OrderByDescending(t => t.CreatedByName),
            ("assignedToName", "asc")   => q.OrderBy(t => t.AssignedToName),
            ("assignedToName", _)       => q.OrderByDescending(t => t.AssignedToName),
            (_, "asc")                    => q.OrderBy(t => t.CreatedAt),
            _                             => q.OrderByDescending(t => t.CreatedAt)
        };

        var csv = ToCsv(q);
        var bytes = Encoding.UTF8.GetBytes(csv);
        return File(bytes, "text/csv; charset=utf-8", "tickets.csv");
    }

    // --- helpers ---

    private static string ToCsv(IEnumerable<TicketListItemDto> items)
    {
        var sb = new StringBuilder();
        sb.AppendLine("ticketId,title,category,priority,status,createdAt,updatedAt,createdByName,assignedToName");
        foreach (var t in items)
        {
            sb.AppendLine(string.Join(',', new[]
            {
                t.TicketId.ToString(),
                CsvEscape(t.Title),
                t.Category.ToString(),
                t.Priority.ToString(),
                t.Status.ToString(),
                t.CreatedAt.ToString("O"),
                t.UpdatedAt?.ToString("O") ?? "",
                CsvEscape(t.CreatedByName),
                CsvEscape(t.AssignedToName)
            }));
        }
        return sb.ToString();
    }

    private static string CsvEscape(string? s)
    {
        if (string.IsNullOrEmpty(s)) return "";
        var needQuotes = s.Contains(',') || s.Contains('"') || s.Contains('\n') || s.Contains('\r');
        var escaped = s.Replace("\"", "\"\"");
        return needQuotes ? $"\"{escaped}\"" : escaped;
    }

    private static List<TicketListItemDto> CreateSeed(int count)
    {
        var list = new List<TicketListItemDto>(count);
        var now = DateTime.UtcNow;
        for (int i = 0; i < count; i++)
        {
            var id = 1000 + i;
            var cat = (byte)((i % 3) + 1);   // 1..3
            var pr  = (byte)((i % 4) + 1);   // 1..4
            var st  = (byte)((i % 7) + 1);   // 1..7

            list.Add(new TicketListItemDto(
                TicketId: id,
                Title: $"Sample ticket #{id}",
                Category: cat,
                Priority: pr,
                Status: st,
                CreatedAt: now.AddDays(-i),
                UpdatedAt: now.AddHours(-i * 12),
                CreatedByName: new[] { "A. Kowalski", "B. Nowak", "C. Wiśniewska" }[i % 3],
                AssignedToName: (i % 3 == 1) ? null : new[] { "M. Zieliński", "P. Zawadzki" }[i % 2]
            ));
        }
        return list;
    }
}